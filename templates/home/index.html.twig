{% extends 'base.html.twig' %}
{% block title %}Accueil{% endblock %}

{% block body %}

<!-- HERO -->
<section style="background: linear-gradient(135deg, var(--sf-dark) 0%, var(--sf-blue) 60%, #4a90d9 100%); color:#fff; padding: 80px 0 60px; overflow:hidden; position:relative;">
    <div style="position:absolute; top:-100px; right:-100px; width:500px; height:500px; background:rgba(76,175,80,.08); border-radius:50%;"></div>
    <div style="position:absolute; bottom:-80px; left:-80px; width:350px; height:350px; background:rgba(255,255,255,.04); border-radius:50%;"></div>
    <div class="container position-relative">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <span class="badge mb-3 px-3 py-2" style="background:rgba(76,175,80,.2); color:#81c784; font-size:.85rem; border-radius:20px;">
                    🏸 Recommandations personnalisées
                </span>
                <h1 class="fw-800 mb-4" style="font-size:3rem; font-weight:800; line-height:1.15;">
                    Trouvez l'équipement<br>
                    <span style="color: var(--sf-green);">fait pour vous</span>
                </h1>
                <p class="mb-4" style="font-size:1.15rem; opacity:.85; line-height:1.7;">
                    SmashFit analyse votre niveau, votre style de jeu et votre fréquence de pratique
                    pour vous recommander le matériel de badminton le plus adapté.
                </p>
                <div class="d-flex gap-3 flex-wrap">
                    {% if app.user %}
                        <a href="{{ path('app_recommandation_index') }}"
                           class="btn btn-sf btn-lg px-4 py-3">
                            <i class="bi bi-stars me-2"></i>Mes recommandations
                        </a>
                        <a href="{{ path('app_materiel_index') }}"
                           class="btn btn-lg px-4 py-3"
                           style="border:2px solid rgba(255,255,255,.4); color:#fff; border-radius:8px;">
                            <i class="bi bi-grid me-2"></i>Voir le catalogue
                        </a>
                    {% else %}
                        <a href="{{ path('app_register') }}"
                           class="btn btn-sf btn-lg px-4 py-3">
                            <i class="bi bi-person-plus me-2"></i>Commencer gratuitement
                        </a>
                        <a href="{{ path('app_materiel_index') }}"
                           class="btn btn-lg px-4 py-3"
                           style="border:2px solid rgba(255,255,255,.4); color:#fff; border-radius:8px;">
                            <i class="bi bi-grid me-2"></i>Explorer le catalogue
                        </a>
                    {% endif %}
                </div>
            </div>
            <div class="col-lg-6 text-center d-none d-lg-block">
                <div style="font-size: 10rem; opacity:.15; position:absolute; right:0; top:-40px;">🏸</div>
                <div style="font-size: 8rem;">🏸</div>
            </div>
        </div>
    </div>
</section>

<!-- STATS -->
<section style="background:#fff; padding:40px 0; border-bottom:1px solid #eee;">
    <div class="container">
        <div class="row text-center g-4">
            {% set total = 0 %}
            {% for s in stats %}{% set total = total + s.total %}{% endfor %}
            <div class="col-6 col-md-3">
                <div class="fw-bold" style="font-size:2.2rem; color:var(--sf-dark);">{{ total }}+</div>
                <div class="text-muted small">Produits référencés</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="fw-bold" style="font-size:2.2rem; color:var(--sf-green);">6</div>
                <div class="text-muted small">Catégories</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="fw-bold" style="font-size:2.2rem; color:var(--sf-dark);">4</div>
                <div class="text-muted small">Niveaux couverts</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="fw-bold" style="font-size:2.2rem; color:var(--sf-green);">100%</div>
                <div class="text-muted small">Personnalisé</div>
            </div>
        </div>
    </div>
</section>

<!-- COMMENT ÇA MARCHE -->
<section style="padding:80px 0;">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="section-title mb-2" style="font-size:2rem;">Comment ça marche ?</h2>
            <p class="section-subtitle">3 étapes pour trouver votre équipement idéal</p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card-sf card p-4 h-100 text-center">
                    <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3"
                         style="width:64px; height:64px; background:linear-gradient(135deg,var(--sf-dark),var(--sf-blue)); font-size:1.8rem;">
                        👤
                    </div>
                    <h5 class="fw-bold mb-2" style="color:var(--sf-dark);">1. Créez votre profil</h5>
                    <p class="text-muted mb-0">Renseignez votre niveau de jeu, votre style (attaquant, défenseur…) et votre fréquence de pratique.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card-sf card p-4 h-100 text-center">
                    <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3"
                         style="width:64px; height:64px; background:linear-gradient(135deg,var(--sf-green),#66BB6A); font-size:1.8rem;">
                        🔍
                    </div>
                    <h5 class="fw-bold mb-2" style="color:var(--sf-dark);">2. Notre algorithme analyse</h5>
                    <p class="text-muted mb-0">SmashFit compare votre profil aux caractéristiques techniques de chaque produit et calcule un score de compatibilité.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card-sf card p-4 h-100 text-center">
                    <div class="rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3"
                         style="width:64px; height:64px; background:linear-gradient(135deg,#f59e0b,#fbbf24); font-size:1.8rem;">
                        ⭐
                    </div>
                    <h5 class="fw-bold mb-2" style="color:var(--sf-dark);">3. Recevez vos recommandations</h5>
                    <p class="text-muted mb-0">Une sélection personnalisée triée par score, avec l'explication de chaque recommandation.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ACTUALITÉS BWF -->
{% if news %}
<section style="background:#fff; padding:60px 0;">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="section-title mb-0" style="font-size:1.6rem;">
                <i class="bi bi-newspaper me-2" style="color:var(--sf-green);"></i>Actualités Badminton
            </h2>
            <span class="badge px-3 py-2" style="background:var(--sf-light); color:var(--sf-dark);">via BWF / FFBaD</span>
        </div>
        <div class="row g-3">
            {% for article in news %}
            <div class="col-md-4">
                <div class="card-sf card p-4 h-100">
                    <div class="small text-muted mb-2">
                        <i class="bi bi-calendar3 me-1"></i>{{ article.date }}
                    </div>
                    <p class="fw-semibold mb-0" style="color:var(--sf-dark); line-height:1.5;">
                        {{ article.titre }}
                    </p>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</section>
{% endif %}

<!-- CTA -->
{% if not app.user %}
<section style="background:linear-gradient(135deg, var(--sf-dark), var(--sf-blue)); padding:70px 0; color:#fff; text-align:center;">
    <div class="container">
        <h2 class="fw-bold mb-3" style="font-size:2rem;">Prêt à trouver votre équipement idéal ?</h2>
        <p class="mb-4 opacity-75" style="font-size:1.1rem;">Créez votre compte gratuitement et obtenez des recommandations personnalisées en 2 minutes.</p>
        <a href="{{ path('app_register') }}" class="btn btn-sf btn-lg px-5 py-3">
            <i class="bi bi-person-plus me-2"></i>Commencer maintenant
        </a>
    </div>
</section>
{% endif %}

{% endblock %}