{% extends 'base.html.twig' %}
{% block title %}Modifier mon profil{% endblock %}

{% block body %}
<div style="max-width:600px; margin:40px auto; padding:0 20px;">
    <div style="display:flex; align-items:center; gap:12px; margin-bottom:24px;">
        <a href="{{ path('app_profil') }}" style="color:#1F3A6D; text-decoration:none;">← Retour</a>
        <h1 style="margin:0;">Modifier mon profil</h1>
    </div>

    {{ form_start(form) }}

    <div style="background:#f8f9fa; border-radius:8px; padding:20px; margin-bottom:20px;">
        <h3 style="margin-top:0;">Informations personnelles</h3>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
            <div>
                {{ form_label(form.nom) }}
                {{ form_widget(form.nom, {'attr': {'style': 'width:100%; padding:8px; margin-top:4px;'}}) }}
            </div>
            <div>
                {{ form_label(form.prenom) }}
                {{ form_widget(form.prenom, {'attr': {'style': 'width:100%; padding:8px; margin-top:4px;'}}) }}
            </div>
            <div>
                {{ form_label(form.age) }}
                {{ form_widget(form.age, {'attr': {'style': 'width:100%; padding:8px; margin-top:4px;'}}) }}
            </div>
        </div>

        <div style="margin-top:12px;">
            {{ form_label(form.club) }}
            <div style="position:relative;">
                {{ form_widget(form.club, {'attr': {'style': 'width:100%; padding:8px; margin-top:4px;', 'autocomplete': 'off'}}) }}
                <div id="club-suggestions"
                     style="display:none; position:absolute; top:100%; left:0; right:0; background:white;
                            border:1px solid #ddd; border-radius:4px; z-index:100; max-height:200px; overflow-y:auto;">
                </div>
            </div>
            <small style="color:#888;">Recherche via l'API FFBaD</small>
        </div>

        <div style="margin-top:12px;">
            {{ form_label(form.numeroLicence) }}
            {{ form_widget(form.numeroLicence, {'attr': {'style': 'width:100%; padding:8px; margin-top:4px;'}}) }}
            <div id="licence-status" style="margin-top:4px; font-size:.85rem;"></div>
        </div>
    </div>

    <div style="background:#f8f9fa; border-radius:8px; padding:20px; margin-bottom:20px;">
        <h3 style="margin-top:0;">Profil joueur <span style="color:#dc3545; font-size:.8rem;">(requis pour les recommandations)</span></h3>

        <div style="margin-bottom:12px;">
            {{ form_label(form.niveau) }}
            {{ form_widget(form.niveau, {'attr': {'style': 'width:100%; padding:8px; margin-top:4px;'}}) }}
        </div>
        <div style="margin-bottom:12px;">
            {{ form_label(form.styleJeu) }}
            {{ form_widget(form.styleJeu, {'attr': {'style': 'width:100%; padding:8px; margin-top:4px;'}}) }}
        </div>
        <div>
            {{ form_label(form.frequence) }}
            {{ form_widget(form.frequence, {'attr': {'style': 'width:100%; padding:8px; margin-top:4px;'}}) }}
        </div>
    </div>

    <button type="submit"
            style="width:100%; padding:12px; background:#4CAF50; color:white; border:none; border-radius:4px; cursor:pointer; font-size:1rem;">
        Enregistrer mon profil
    </button>

    {{ form_end(form) }}
</div>
{% endblock %}

{% block javascripts %}
<script>
// Recherche de club via API FFBaD
let clubTimer;
const clubInput = document.getElementById('club-input');
const suggestions = document.getElementById('club-suggestions');

clubInput.addEventListener('input', () => {
    clearTimeout(clubTimer);
    const q = clubInput.value.trim();
    if (q.length < 2) { suggestions.style.display = 'none'; return; }

    clubTimer = setTimeout(() => {
        fetch('/profil/clubs/search?q=' + encodeURIComponent(q))
        .then(r => r.json())
        .then(clubs => {
            suggestions.innerHTML = '';
            if (!clubs.length) { suggestions.style.display = 'none'; return; }
            clubs.forEach(club => {
                const item = document.createElement('div');
                item.style.cssText = 'padding:8px 12px; cursor:pointer; border-bottom:1px solid #eee;';
                item.textContent = club.nom + ' (' + club.ville + ')';
                item.addEventListener('mouseenter', () => item.style.background = '#f0f4ff');
                item.addEventListener('mouseleave', () => item.style.background = '');
                item.addEventListener('click', () => {
                    clubInput.value = club.nom;
                    suggestions.style.display = 'none';
                });
                suggestions.appendChild(item);
            });
            suggestions.style.display = 'block';
        });
    }, 350);
});

document.addEventListener('click', e => {
    if (!clubInput.contains(e.target)) suggestions.style.display = 'none';
});

// Vérification de licence FFBaD
let licenceTimer;
const licenceInput = document.getElementById('licence-input');
const licenceStatus = document.getElementById('licence-status');

licenceInput.addEventListener('input', () => {
    clearTimeout(licenceTimer);
    const num = licenceInput.value.trim();
    if (num.length < 6) { licenceStatus.textContent = ''; return; }

    licenceTimer = setTimeout(() => {
        licenceStatus.textContent = 'Vérification...';
        fetch('/profil/licence/verify', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'numero=' + encodeURIComponent(num)
        })
        .then(r => r.json())
        .then(data => {
            if (data.demo) {
                licenceStatus.style.color = '#856404';
                licenceStatus.textContent = '⚠️ ' + data.message;
            } else if (data.valide) {
                licenceStatus.style.color = '#155724';
                licenceStatus.textContent = '✅ Licence valide';
            } else {
                licenceStatus.style.color = '#721c24';
                licenceStatus.textContent = '❌ ' + (data.message || 'Licence introuvable');
            }
        });
    }, 600);
});
</script>
{% endblock %}