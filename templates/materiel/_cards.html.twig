{% for m in materiels %}
<div class="col-sm-6 col-xl-4">
    <div class="mat-card card h-100">
        {% if m.imageUrl %}
            <img src="{{ m.imageUrl }}" alt="{{ m.nom }}" class="mat-img w-100">
        {% else %}
            <div class="mat-placeholder">
                {{ m.type == 'raquette' ? '🏸' : (m.type == 'chaussures' ? '👟' : (m.type == 'cordage' ? '🪢' : (m.type == 'volant' ? '🪶' : (m.type == 'sac' ? '🎒' : '👕')))) }}
            </div>
        {% endif %}
        <div class="card-body d-flex flex-column p-3">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <span class="badge badge-type badge-{{ m.type }}">{{ m.typeLabel }}</span>
                <span class="text-muted" style="font-size:.78rem;">{{ m.marque.nomMarque }}</span>
            </div>
            <h6 class="fw-bold mb-1" style="color:var(--sf-dark); font-size:.95rem;">{{ m.nom }}</h6>
            <p class="text-muted mb-2 flex-grow-1" style="font-size:.82rem; line-height:1.5; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">
                {{ m.description }}
            </p>
            <div class="d-flex flex-wrap gap-1 mb-3">
                <span class="badge" style="background:#f0f4ff; color:var(--sf-dark); font-size:.72rem;">{{ m.niveauLabel }}</span>
                {% if m.flexibilite %}
                <span class="badge" style="background:#f0f4ff; color:var(--sf-dark); font-size:.72rem;">{{ m.flexibilite }}</span>
                {% endif %}
            </div>
            <div class="d-flex justify-content-between align-items-center mt-auto">
                {% if m.prix %}
                    <span class="fw-bold" style="color:var(--sf-green); font-size:1rem;">{{ m.prix }}€</span>
                {% else %}
                    <span></span>
                {% endif %}
                <a href="{{ path('app_materiel_show', {'id': m.id}) }}"
                   class="btn btn-sf-dark btn-sm px-3">
                    Voir <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>
</div>
{% else %}
<div class="col-12 text-center py-5">
    <div style="font-size:3rem; opacity:.3;">📦</div>
    <h5 class="text-muted mt-3">Aucun produit disponible</h5>
</div>
{% endfor %}