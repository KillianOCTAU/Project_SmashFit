{% extends 'base.html.twig' %}
{% block title %}Catalogue Matériel{% endblock %}

{% block extra_css %}
<style>
.filter-sidebar { background:#fff; border-radius:12px; padding:24px; box-shadow:0 2px 16px rgba(0,0,0,.07); position:sticky; top:80px; }
.filter-label { font-size:.8rem; font-weight:600; text-transform:uppercase; letter-spacing:.5px; color:var(--sf-gray); margin-bottom:6px; }
.mat-card { border:none; border-radius:12px; box-shadow:0 2px 16px rgba(0,0,0,.07); transition:all .2s; overflow:hidden; }
.mat-card:hover { transform:translateY(-4px); box-shadow:0 8px 32px rgba(0,0,0,.13); }
.mat-img { height:180px; object-fit:contain; padding:16px; background:#f8fbff; }
.mat-placeholder { height:180px; display:flex; align-items:center; justify-content:center; background:#f0f4ff; font-size:3.5rem; }
.badge-type { font-size:.72rem; font-weight:600; padding:4px 10px; border-radius:20px; }
</style>
{% endblock %}

{% block body %}
<div class="page-header">
    <div class="container d-flex justify-content-between align-items-center">
        <div>
            <h1 class="fw-bold mb-1">🏸 Catalogue Matériel</h1>
            <p class="opacity-75 mb-0">Explorez et filtrez notre sélection d'équipements</p>
        </div>
        {% if app.user %}
        <a href="{{ path('app_recommandation_index') }}" class="btn btn-sf px-4">
            <i class="bi bi-stars me-2"></i>Mes recommandations
        </a>
        {% endif %}
    </div>
</div>

<div class="container pb-5">
    <div class="row g-4">

        <!-- Filtres -->
        <div class="col-lg-3">
            <div class="filter-sidebar">
                <h6 class="fw-bold mb-4" style="color:var(--sf-dark);">
                    <i class="bi bi-funnel me-2"></i>Filtres
                </h6>

                <div class="mb-3">
                    <div class="filter-label">Rechercher</div>
                    <input type="text" id="f-search" class="form-control form-control-sm"
                           placeholder="Nom du produit..."
                           value="{{ criteres.search }}">
                </div>

                <div class="mb-3">
                    <div class="filter-label">Type</div>
                    <select id="f-type" class="form-select form-select-sm">
                        <option value="">Tous les types</option>
                        {% for type in types %}
                        <option value="{{ type }}" {{ criteres.type == type ? 'selected' : '' }}>
                            {{ type|capitalize }}
                        </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="mb-3">
                    <div class="filter-label">Niveau</div>
                    <select id="f-niveau" class="form-select form-select-sm">
                        <option value="">Tous</option>
                        <option value="debutant"      {{ criteres.niveau == 'debutant'      ? 'selected' : '' }}>Débutant</option>
                        <option value="intermediaire" {{ criteres.niveau == 'intermediaire' ? 'selected' : '' }}>Intermédiaire</option>
                        <option value="avance"        {{ criteres.niveau == 'avance'        ? 'selected' : '' }}>Avancé</option>
                        <option value="expert"        {{ criteres.niveau == 'expert'        ? 'selected' : '' }}>Expert</option>
                    </select>
                </div>

                <div class="mb-3">
                    <div class="filter-label">Flexibilité</div>
                    <select id="f-flex" class="form-select form-select-sm">
                        <option value="">Toutes</option>
                        {% for f in flexibilites %}
                        <option value="{{ f }}" {{ criteres.flexibilite == f ? 'selected' : '' }}>
                            {{ f|capitalize }}
                        </option>
                        {% endfor %}
                    </select>
                </div>

                <div class="mb-3">
                    <div class="filter-label">Équilibre</div>
                    <select id="f-eq" class="form-select form-select-sm">
                        <option value="">Tous</option>
                        <option value="tete-lourde"  {{ criteres.equilibre == 'tete-lourde'  ? 'selected' : '' }}>Tête lourde</option>
                        <option value="equilibre"    {{ criteres.equilibre == 'equilibre'    ? 'selected' : '' }}>Équilibré</option>
                        <option value="manche-lourd" {{ criteres.equilibre == 'manche-lourd' ? 'selected' : '' }}>Manche lourd</option>
                    </select>
                </div>

                <div class="mb-4">
                    <div class="filter-label">Marque</div>
                    <select id="f-marque" class="form-select form-select-sm">
                        <option value="">Toutes les marques</option>
                        {% for m in marques %}
                        <option value="{{ m.id }}" {{ criteres.marque == (m.id ~ '') ? 'selected' : '' }}>
                            {{ m.nomMarque }}
                        </option>
                        {% endfor %}
                    </select>
                </div>

                <button onclick="resetFilters()" class="btn btn-outline-secondary btn-sm w-100">
                    <i class="bi bi-x-circle me-1"></i>Réinitialiser
                </button>
            </div>
        </div>

        <!-- Résultats -->
        <div class="col-lg-9">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span id="count" class="text-muted small fw-semibold">
                    <i class="bi bi-grid me-1"></i>{{ materiels|length }} produit(s) trouvé(s)
                </span>
            </div>

            <div id="grid" class="row g-3">
                {% include 'materiel/_cards.html.twig' with {'materiels': materiels} %}
            </div>

            <div id="no-result" class="text-center py-5 d-none">
                <div style="font-size:3rem; opacity:.3;">🔍</div>
                <h5 class="text-muted mt-3">Aucun produit ne correspond à vos critères</h5>
                <button onclick="resetFilters()" class="btn btn-sf mt-3">Réinitialiser les filtres</button>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block extra_js %}
<script>
const filters = ['f-search','f-type','f-niveau','f-flex','f-eq','f-marque'];
const map = { 'f-search':'search','f-type':'type','f-niveau':'niveau','f-flex':'flexibilite','f-eq':'equilibre','f-marque':'marque' };
let timer;

function applyFilters() {
    const params = new URLSearchParams();
    filters.forEach(id => {
        const el = document.getElementById(id);
        if (el.value) params.set(map[id], el.value);
    });
    const grid = document.getElementById('grid');
    grid.style.opacity = '.5';
    fetch('/materiels?' + params.toString(), { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
    .then(r => r.json())
    .then(data => {
        grid.innerHTML = data.html;
        grid.style.opacity = '1';
        document.getElementById('count').innerHTML = '<i class="bi bi-grid me-1"></i>' + data.count + ' produit(s) trouvé(s)';
        document.getElementById('no-result').classList.toggle('d-none', data.count > 0);
        grid.classList.toggle('d-none', data.count === 0);
    });
}

function resetFilters() {
    filters.forEach(id => document.getElementById(id).value = '');
    applyFilters();
}

filters.forEach(id => {
    const el = document.getElementById(id);
    if (el.tagName === 'SELECT') {
        el.addEventListener('change', applyFilters);
    } else {
        el.addEventListener('input', () => { clearTimeout(timer); timer = setTimeout(applyFilters, 400); });
    }
});
</script>
{% endblock %}