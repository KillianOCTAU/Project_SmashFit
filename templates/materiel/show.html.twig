{% extends 'base.html.twig' %}
{% block title %}{{ materiel.nom }}{% endblock %}

{% block body %}
<div class="container py-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_home') }}" style="color:var(--sf-blue);">Accueil</a></li>
            <li class="breadcrumb-item"><a href="{{ path('app_materiel_index') }}" style="color:var(--sf-blue);">Matériels</a></li>
            <li class="breadcrumb-item active">{{ materiel.nom }}</li>
        </ol>
    </nav>

    <div class="row g-5">
        <div class="col-md-5">
            <div class="card-sf card p-4 text-center">
                {% if materiel.imageUrl %}
                    <img src="{{ materiel.imageUrl }}" alt="{{ materiel.nom }}"
                         style="max-height:300px; width:100%; object-fit:contain;">
                {% else %}
                    <div style="height:280px; display:flex; align-items:center; justify-content:center; font-size:7rem; background:#f0f4ff; border-radius:8px;">
                        {{ materiel.type == 'raquette' ? '🏸' : (materiel.type == 'chaussures' ? '👟' : '📦') }}
                    </div>
                {% endif %}
                <span class="badge badge-type badge-{{ materiel.type }} mt-3">{{ materiel.typeLabel }}</span>
            </div>
        </div>

        <div class="col-md-7">
            <p class="text-muted mb-1" style="font-size:.9rem;">{{ materiel.marque.nomMarque }}</p>
            <h1 class="fw-bold mb-3" style="color:var(--sf-dark);">{{ materiel.nom }}</h1>

            {% if materiel.prix %}
            <div class="mb-3">
                <span class="fw-bold" style="font-size:1.8rem; color:var(--sf-green);">{{ materiel.prix }}€</span>
                <span class="text-muted ms-2 small">Prix indicatif</span>
            </div>
            {% endif %}

            <p class="text-muted mb-4" style="line-height:1.7;">{{ materiel.description }}</p>

            <h6 class="fw-bold mb-3" style="color:var(--sf-dark);">Caractéristiques</h6>
            <div class="row g-2 mb-4">
                <div class="col-6">
                    <div class="p-3 rounded text-center" style="background:#f0f4ff;">
                        <div class="small text-muted mb-1">Niveau</div>
                        <div class="fw-semibold" style="color:var(--sf-dark);">{{ materiel.niveauLabel }}</div>
                    </div>
                </div>
                {% if materiel.poids %}
                <div class="col-6">
                    <div class="p-3 rounded text-center" style="background:#f0f4ff;">
                        <div class="small text-muted mb-1">Poids</div>
                        <div class="fw-semibold" style="color:var(--sf-dark);">{{ materiel.poids }}</div>
                    </div>
                </div>
                {% endif %}
                {% if materiel.flexibilite %}
                <div class="col-6">
                    <div class="p-3 rounded text-center" style="background:#f0f4ff;">
                        <div class="small text-muted mb-1">Flexibilité</div>
                        <div class="fw-semibold" style="color:var(--sf-dark);">{{ materiel.flexibilite|capitalize }}</div>
                    </div>
                </div>
                {% endif %}
                {% if materiel.equilibre %}
                <div class="col-6">
                    <div class="p-3 rounded text-center" style="background:#f0f4ff;">
                        <div class="small text-muted mb-1">Équilibre</div>
                        <div class="fw-semibold" style="color:var(--sf-dark);">{{ materiel.equilibre|replace({'-': ' '})|capitalize }}</div>
                    </div>
                </div>
                {% endif %}
                {% if materiel.materiau %}
                <div class="col-6">
                    <div class="p-3 rounded text-center" style="background:#f0f4ff;">
                        <div class="small text-muted mb-1">Matériau</div>
                        <div class="fw-semibold" style="color:var(--sf-dark);">{{ materiel.materiau }}</div>
                    </div>
                </div>
                {% endif %}
            </div>

            <div class="d-flex gap-3">
                <a href="{{ path('app_materiel_index') }}" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Retour
                </a>
                {% if app.user %}
                <a href="{{ path('app_recommandation_index') }}" class="btn btn-sf px-4">
                    <i class="bi bi-stars me-2"></i>Mes recommandations
                </a>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}