{% extends 'base.html.twig' %}
{% block title %}Connexion{% endblock %}

{% block body %}
<div style="max-width:400px; margin:60px auto; padding:20px; border:1px solid #ddd; border-radius:8px;">
    <h2>🔐 Connexion</h2>

    {% if error %}
        <div style="color:red; margin-bottom:10px;">
            {{ error.messageKey|trans(error.messageData, 'security') }}
        </div>
    {% endif %}

    {% for message in app.flashes('success') %}
        <div style="color:green; margin-bottom:10px;">{{ message }}</div>
    {% endfor %}

    <form method="post" action="{{ path('app_login') }}">
        <div style="margin-bottom:12px;">
            <label>Email</label><br>
            <input type="email" name="_username" value="{{ last_username }}"
                   style="width:100%; padding:8px; margin-top:4px;"
                   autocomplete="email" autofocus>
        </div>
        <div style="margin-bottom:12px;">
            <label>Mot de passe</label><br>
            <input type="password" name="_password"
                   style="width:100%; padding:8px; margin-top:4px;"
                   autocomplete="current-password">
        </div>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <button type="submit"
                style="width:100%; padding:10px; background:#1F3A6D; color:white; border:none; border-radius:4px; cursor:pointer;">
            Se connecter
        </button>
    </form>

    <p style="margin-top:16px; text-align:center;">
        Pas encore de compte ? <a href="{{ path('app_register') }}">S'inscrire</a>
    </p>
</div>
{% endblock %}