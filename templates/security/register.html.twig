{% extends 'base.html.twig' %}
{% block title %}Inscription{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card-sf card p-4 p-md-5">
                <div class="text-center mb-4">
                    <div style="font-size:2.5rem;">🏸</div>
                    <h3 class="fw-bold mt-2 mb-1" style="color:var(--sf-dark);">Créer un compte</h3>
                    <p class="text-muted small">Rejoignez SmashFit gratuitement</p>
                </div>

                {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                <div class="mb-3">
                    {{ form_label(form.pseudo, null, {'label_attr': {'class': 'form-label fw-semibold small'}}) }}
                    {{ form_widget(form.pseudo, {'attr': {'class': 'form-control', 'placeholder': 'Votre pseudo'}}) }}
                    {{ form_errors(form.pseudo) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.email, null, {'label_attr': {'class': 'form-label fw-semibold small'}}) }}
                    {{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': 'votre@email.com'}}) }}
                    {{ form_errors(form.email) }}
                </div>
                <div class="mb-3">
                    {{ form_label(form.plainPassword.first, null, {'label_attr': {'class': 'form-label fw-semibond small'}}) }}
                    {{ form_widget(form.plainPassword.first, {'attr': {'class': 'form-control', 'placeholder': 'Minimum 8 caractères'}}) }}
                </div>
                <div class="mb-4">
                    {{ form_label(form.plainPassword.second, null, {'label_attr': {'class': 'form-label fw-semibold small'}}) }}
                    {{ form_widget(form.plainPassword.second, {'attr': {'class': 'form-control', 'placeholder': 'Répétez le mot de passe'}}) }}
                    {{ form_errors(form.plainPassword) }}
                </div>
                <button class="btn btn-sf w-100 py-2" type="submit">
                    <i class="bi bi-person-plus me-2"></i>Créer mon compte
                </button>
                {{ form_end(form) }}

                <hr class="my-4">
                <p class="text-center text-muted small mb-0">
                    Déjà un compte ?
                    <a href="{{ path('app_login') }}" style="color:var(--sf-green); font-weight:600;">Se connecter</a>
                </p>
            </div>
        </div>
    </div>
</div>
{% endblock %}