{% extends 'base.html.twig' %}
{% block title %}Admin – Matériels{% endblock %}

{% block body %}
<div style="max-width:1000px; margin:40px auto; padding:0 20px;">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:24px;">
        <h1>📦 Matériels</h1>
        <div style="display:flex; gap:10px;">
            <a href="{{ path('app_admin_dashboard') }}"
               style="padding:8px 16px; border:1px solid #ccc; border-radius:4px; text-decoration:none; color:#333;">
                ← Dashboard
            </a>
            <a href="{{ path('app_admin_materiel_new') }}"
               style="padding:8px 16px; background:#1F3A6D; color:white; border-radius:4px; text-decoration:none;">
                + Ajouter un produit
            </a>
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div style="background:#d4edda; color:#155724; padding:10px; border-radius:4px; margin-bottom:16px;">
            {{ message }}
        </div>
    {% endfor %}

    <table style="width:100%; border-collapse:collapse;">
        <thead>
            <tr style="background:#f8f9fa;">
                <th style="padding:12px; text-align:left; border-bottom:2px solid #dee2e6;">Nom</th>
                <th style="padding:12px; text-align:left; border-bottom:2px solid #dee2e6;">Type</th>
                <th style="padding:12px; text-align:left; border-bottom:2px solid #dee2e6;">Marque</th>
                <th style="padding:12px; text-align:left; border-bottom:2px solid #dee2e6;">Niveau</th>
                <th style="padding:12px; text-align:left; border-bottom:2px solid #dee2e6;">Prix</th>
                <th style="padding:12px; border-bottom:2px solid #dee2e6;"></th>
            </tr>
        </thead>
        <tbody>
            {% for m in materiels %}
            <tr style="border-bottom:1px solid #eee;">
                <td style="padding:12px; font-weight:600;">{{ m.nom }}</td>
                <td style="padding:12px;">{{ m.typeLabel }}</td>
                <td style="padding:12px;">{{ m.marque.nomMarque }}</td>
                <td style="padding:12px;">{{ m.niveauLabel }}</td>
                <td style="padding:12px;">{{ m.prix ? m.prix ~ ' €' : '—' }}</td>
                <td style="padding:12px; text-align:right; display:flex; gap:6px; justify-content:flex-end;">
                    <a href="{{ path('app_admin_materiel_edit', {'id': m.id}) }}"
                       style="padding:4px 10px; background:#1F3A6D; color:white; border-radius:4px; text-decoration:none;">
                        Modifier
                    </a>
                    <form method="post"
                          action="{{ path('app_admin_materiel_delete', {'id': m.id}) }}"
                          onsubmit="return confirm('Supprimer ce produit ?')"
                          style="display:inline;">
                        <input type="hidden" name="_token"
                               value="{{ csrf_token('delete_mat_' ~ m.id) }}">
                        <button type="submit"
                                style="padding:4px 10px; background:#dc3545; color:white; border:none; border-radius:4px; cursor:pointer;">
                            Supprimer
                        </button>
                    </form>
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="6" style="padding:20px; text-align:center; color:#888;">
                    Aucun produit pour l'instant.
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}