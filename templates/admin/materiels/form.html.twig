{% extends 'base.html.twig' %}
{% block title %}{{ materiel.id ? 'Modifier' : 'Ajouter' }} un produit{% endblock %}

{% block body %}
<div style="max-width:600px; margin:40px auto; padding:0 20px;">
    <div style="display:flex; align-items:center; gap:12px; margin-bottom:24px;">
        <a href="{{ path('app_admin_materiels') }}"
           style="color:#1F3A6D; text-decoration:none;">← Retour</a>
        <h1 style="margin:0;">{{ materiel.id ? 'Modifier le produit' : 'Ajouter un produit' }}</h1>
    </div>

    {{ form_start(form) }}
        {% for field in form %}
            {% if field.vars.name != '_token' %}
            <div style="margin-bottom:16px;">
                {{ form_label(field) }}
                {{ form_widget(field, {'attr': {'style': 'width:100%; padding:8px; margin-top:4px;'}}) }}
                {{ form_errors(field) }}
            </div>
            {% endif %}
        {% endfor %}
        <button type="submit"
                style="padding:10px 24px; background:#1F3A6D; color:white; border:none; border-radius:4px; cursor:pointer;">
            Enregistrer
        </button>
    {{ form_end(form) }}
</div>
{% endblock %}