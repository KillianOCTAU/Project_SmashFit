{% extends 'base.html.twig' %}
{% block title %}Admin – Marques{% endblock %}

{% block body %}
<div style="max-width:900px; margin:40px auto; padding:0 20px;">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:24px;">
        <h1>🏷️ Marques</h1>
        <div style="display:flex; gap:10px;">
            <a href="{{ path('app_admin_dashboard') }}"
               style="padding:8px 16px; border:1px solid #ccc; border-radius:4px; text-decoration:none; color:#333;">
                ← Dashboard
            </a>
            <a href="{{ path('app_admin_marque_new') }}"
               style="padding:8px 16px; background:#4CAF50; color:white; border-radius:4px; text-decoration:none;">
                + Nouvelle marque
            </a>
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div style="background:#d4edda; color:#155724; padding:10px; border-radius:4px; margin-bottom:16px;">
            {{ message }}
        </div>
    {% endfor %}

    <table style="width:100%; border-collapse:collapse;">
        <thead>
            <tr style="background:#f8f9fa;">
                <th style="padding:12px; text-align:left; border-bottom:2px solid #dee2e6;">Nom</th>
                <th style="padding:12px; text-align:left; border-bottom:2px solid #dee2e6;">Pays</th>
                <th style="padding:12px; text-align:left; border-bottom:2px solid #dee2e6;">Produits</th>
                <th style="padding:12px; border-bottom:2px solid #dee2e6;"></th>
            </tr>
        </thead>
        <tbody>
            {% for marque in marques %}
            <tr style="border-bottom:1px solid #eee;">
                <td style="padding:12px; font-weight:600;">{{ marque.nomMarque }}</td>
                <td style="padding:12px; color:#666;">{{ marque.pays ?? '—' }}</td>
                <td style="padding:12px;">{{ marque.materiels|length }}</td>
                <td style="padding:12px; text-align:right;">
                    <form method="post"
                          action="{{ path('app_admin_marque_delete', {'id': marque.id}) }}"
                          onsubmit="return confirm('Supprimer cette marque ?')"
                          style="display:inline;">
                        <input type="hidden" name="_token"
                               value="{{ csrf_token('delete_marque_' ~ marque.id) }}">
                        <button type="submit"
                                style="padding:4px 10px; background:#dc3545; color:white; border:none; border-radius:4px; cursor:pointer;">
                            Supprimer
                        </button>
                    </form>
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="4" style="padding:20px; text-align:center; color:#888;">
                    Aucune marque pour l'instant.
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}