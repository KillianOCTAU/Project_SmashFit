{% extends 'base.html.twig' %}
{% block title %}Administration{% endblock %}

{% block body %}
<div style="max-width:900px; margin:40px auto; padding:0 20px;">
    <h1>🛡️ Tableau de bord Admin</h1>

    <div style="display:flex; gap:20px; margin:30px 0;">
        <div style="flex:1; padding:20px; border:1px solid #ddd; border-radius:8px; text-align:center;">
            <div style="font-size:2.5rem; font-weight:bold; color:#1F3A6D;">{{ nbMateriels }}</div>
            <div style="color:#666; margin-top:4px;">Produits référencés</div>
        </div>
        <div style="flex:1; padding:20px; border:1px solid #ddd; border-radius:8px; text-align:center;">
            <div style="font-size:2.5rem; font-weight:bold; color:#4CAF50;">{{ nbMarques }}</div>
            <div style="color:#666; margin-top:4px;">Marques</div>
        </div>
    </div>

    <div style="display:flex; gap:16px;">
        <a href="{{ path('app_admin_materiels') }}"
           style="flex:1; padding:16px; background:#1F3A6D; color:white; border-radius:8px; text-decoration:none; text-align:center;">
            📦 Gérer les matériels
        </a>
        <a href="{{ path('app_admin_marques') }}"
           style="flex:1; padding:16px; background:#4CAF50; color:white; border-radius:8px; text-decoration:none; text-align:center;">
            🏷️ Gérer les marques
        </a>
    </div>
</div>
{% endblock %}