{% extends 'base.html.twig' %}
{% block title %}Mes recommandations{% endblock %}

{% block body %}
<div class="page-header">
    <div class="container d-flex justify-content-between align-items-center">
        <div>
            <h1 class="fw-bold mb-1">⭐ Mes recommandations</h1>
            <p class="opacity-75 mb-0">Sélection personnalisée selon votre profil joueur</p>
        </div>
        <a href="{{ path('app_recommandation_generate') }}" class="btn btn-sf px-4">
            <i class="bi bi-arrow-clockwise me-2"></i>Actualiser
        </a>
    </div>
</div>

<div class="container pb-5">

    <!-- Récap profil -->
    <div class="card-sf card p-4 mb-4" style="background:linear-gradient(135deg,#f0f4ff,#e8f5e9);">
        <div class="row align-items-center g-3">
            <div class="col-auto">
                <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold"
                     style="width:50px;height:50px;background:var(--sf-dark);color:#fff;font-size:1.2rem;">
                    {{ app.user.pseudo|first|upper }}
                </div>
            </div>
            <div class="col">
                <div class="fw-bold" style="color:var(--sf-dark);">{{ app.user.pseudo }}</div>
                <div class="text-muted small">{{ profil.niveauLabel }} · {{ profil.styleJeuLabel }} · {{ profil.frequence|capitalize }}</div>
            </div>
            <div class="col-auto">
                <span class="badge px-3 py-2" style="background:var(--sf-dark); color:#fff;">
                    {{ recommandations|length }} résultat(s)
                </span>
            </div>
        </div>
    </div>

    <!-- Liste -->
    <div class="d-flex flex-column gap-3">
        {% for reco in recommandations %}
        <div class="card-sf card p-4">
            <div class="row align-items-center g-3">

                <!-- Image -->
                <div class="col-auto">
                    <div class="rounded-3 d-flex align-items-center justify-content-center"
                         style="width:72px;height:72px;background:#f0f4ff;font-size:2.2rem;">
                        {% if reco.materiel.imageUrl %}
                            <img src="{{ reco.materiel.imageUrl }}" alt="{{ reco.materiel.nom }}"
                                 style="width:100%;height:100%;object-fit:contain;border-radius:8px;">
                        {% else %}
                            {{ reco.materiel.type == 'raquette' ? '🏸' : (reco.materiel.type == 'chaussures' ? '👟' : '📦') }}
                        {% endif %}
                    </div>
                </div>

                <!-- Infos -->
                <div class="col">
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge badge-type badge-{{ reco.materiel.type }}">{{ reco.materiel.typeLabel }}</span>
                        <span class="text-muted small">{{ reco.materiel.marque.nomMarque }}</span>
                    </div>
                    <div class="fw-bold mb-1" style="color:var(--sf-dark); font-size:1.05rem;">
                        {{ reco.materiel.nom }}
                    </div>
                    {% if reco.explication %}
                    <div class="text-muted small">
                        <i class="bi bi-lightbulb me-1" style="color:var(--sf-green);"></i>
                        {{ reco.explication }}
                    </div>
                    {% endif %}
                </div>

                <!-- Score -->
                <div class="col-md-3 text-center">
                    <div class="fw-bold mb-1"
                         style="font-size:2rem; color:{% if reco.score >= 0.7 %}var(--sf-green){% elseif reco.score >= 0.5 %}#f59e0b{% else %}#ef4444{% endif %};">
                        {{ reco.scorePourcent }}%
                    </div>
                    <div class="score-bar mb-1">
                        <div class="score-bar-fill"
                             style="width:{{ reco.scorePourcent }}%; background:{% if reco.score >= 0.7 %}var(--sf-green){% elseif reco.score >= 0.5 %}#f59e0b{% else %}#ef4444{% endif %};"></div>
                    </div>
                    <div class="text-muted" style="font-size:.75rem;">compatibilité</div>
                </div>

                <!-- Action -->
                <div class="col-auto">
                    <a href="{{ path('app_materiel_show', {'id': reco.materiel.id}) }}"
                       class="btn btn-sf-dark btn-sm px-3">
                        Voir <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
</div>
{% endblock %}