<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}SmashFit{% endblock %} | Équipement Badminton</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --sf-dark:     #1F3A6D;
            --sf-blue:     #2E5B9A;
            --sf-green:    #4CAF50;
            --sf-green-dk: #388E3C;
            --sf-light:    #F8FBFF;
            --sf-gray:     #6c757d;
        }

        * { font-family: 'Inter', sans-serif; }
        body { background-color: var(--sf-light); color: #212529; }

        /* ── Navbar ── */
        .navbar-smashfit {
            background: linear-gradient(135deg, var(--sf-dark) 0%, var(--sf-blue) 100%);
            box-shadow: 0 2px 20px rgba(31,58,109,.25);
            padding: 12px 0;
        }
        .navbar-brand-sf {
            font-size: 1.5rem;
            font-weight: 800;
            color: #fff !important;
            letter-spacing: -0.5px;
        }
        .navbar-brand-sf span { color: var(--sf-green); }
        .navbar-smashfit .nav-link {
            color: rgba(255,255,255,.8) !important;
            font-weight: 500;
            font-size: .95rem;
            padding: 6px 14px !important;
            border-radius: 6px;
            transition: all .2s;
        }
        .navbar-smashfit .nav-link:hover,
        .navbar-smashfit .nav-link.active {
            color: #fff !important;
            background: rgba(255,255,255,.12);
        }
        .navbar-toggler { border-color: rgba(255,255,255,.3); }
        .navbar-toggler-icon {
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba%28255,255,255,.8%29' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e");
        }

        /* ── Boutons ── */
        .btn-sf {
            background: var(--sf-green);
            color: #fff;
            border: none;
            font-weight: 600;
            border-radius: 8px;
            transition: all .2s;
        }
        .btn-sf:hover { background: var(--sf-green-dk); color: #fff; transform: translateY(-1px); }

        .btn-sf-outline {
            border: 2px solid var(--sf-green);
            color: var(--sf-green);
            font-weight: 600;
            border-radius: 8px;
            background: transparent;
            transition: all .2s;
        }
        .btn-sf-outline:hover { background: var(--sf-green); color: #fff; }

        .btn-sf-dark {
            background: var(--sf-dark);
            color: #fff;
            border: none;
            font-weight: 600;
            border-radius: 8px;
            transition: all .2s;
        }
        .btn-sf-dark:hover { background: var(--sf-blue); color: #fff; }

        /* ── Cards ── */
        .card-sf {
            border: none;
            border-radius: 12px;
            box-shadow: 0 2px 16px rgba(0,0,0,.07);
            transition: transform .2s, box-shadow .2s;
            overflow: hidden;
        }
        .card-sf:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 32px rgba(0,0,0,.13);
        }

        /* ── Badges type matériel ── */
        .badge-raquette   { background:#dbeafe; color:#1e40af; }
        .badge-cordage    { background:#dcfce7; color:#166534; }
        .badge-chaussures { background:#fef3c7; color:#92400e; }
        .badge-volant     { background:#fce7f3; color:#9d174d; }
        .badge-sac        { background:#ede9fe; color:#5b21b6; }
        .badge-tenue      { background:#e0f2fe; color:#075985; }

        /* ── Score bar ── */
        .score-bar { height: 6px; border-radius: 3px; background: #e9ecef; }
        .score-bar-fill { height: 100%; border-radius: 3px; transition: width .5s ease; }

        /* ── Flash messages ── */
        .alert { border-radius: 10px; border: none; font-weight: 500; }

        /* ── Footer ── */
        .footer-sf {
            background: var(--sf-dark);
            color: rgba(255,255,255,.7);
            padding: 48px 0 24px;
            margin-top: 80px;
        }
        .footer-sf h5, .footer-sf h6 { color: #fff; font-weight: 700; }
        .footer-sf a { color: rgba(255,255,255,.6); text-decoration: none; transition: color .2s; }
        .footer-sf a:hover { color: var(--sf-green); }
        .footer-sf .footer-divider { border-color: rgba(255,255,255,.1); }
        .footer-sf .footer-bottom { color: rgba(255,255,255,.4); font-size: .85rem; }

        /* ── Section titles ── */
        .section-title { font-weight: 800; color: var(--sf-dark); }
        .section-subtitle { color: var(--sf-gray); font-size: 1.05rem; }

        /* ── Page header ── */
        .page-header {
            background: linear-gradient(135deg, var(--sf-dark), var(--sf-blue));
            color: #fff;
            padding: 48px 0 40px;
            margin-bottom: 40px;
        }

        {% block extra_css %}{% endblock %}
    </style>
</head>
<body>

<!-- ══ NAVBAR ══ -->
<nav class="navbar navbar-expand-lg navbar-smashfit sticky-top">
    <div class="container">
        <a class="navbar-brand navbar-brand-sf" href="{{ path('app_home') }}">
            🏸 Smash<span>Fit</span>
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navMain">
            <ul class="navbar-nav me-auto gap-1">
                <li class="nav-item">
                    <a class="nav-link {{ app.request.attributes.get('_route') == 'app_home' ? 'active' : '' }}"
                       href="{{ path('app_home') }}">
                        <i class="bi bi-house me-1"></i>Accueil
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ app.request.attributes.get('_route') starts with 'app_materiel' ? 'active' : '' }}"
                       href="{{ path('app_materiel_index') }}">
                        <i class="bi bi-grid me-1"></i>Matériels
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ app.request.attributes.get('_route') == 'app_informations' ? 'active' : '' }}"
                       href="{{ path('app_informations') }}">
                        <i class="bi bi-info-circle me-1"></i>Informations
                    </a>
                </li>
                {% if app.user %}
                <li class="nav-item">
                    <a class="nav-link {{ app.request.attributes.get('_route') starts with 'app_recommandation' ? 'active' : '' }}"
                       href="{{ path('app_recommandation_index') }}">
                        <i class="bi bi-stars me-1"></i>Recommandations
                    </a>
                </li>
                {% endif %}
            </ul>

            <div class="d-flex align-items-center gap-2">
                {% if app.user %}
                    {% if app.user.isAdmin %}
                    <a href="{{ path('app_admin_dashboard') }}" class="btn btn-sm btn-sf-outline"
                       style="border-color:rgba(255,255,255,.4); color:#fff;">
                        <i class="bi bi-shield-check me-1"></i>Admin
                    </a>
                    {% endif %}

                    <div class="dropdown">
                        <button class="btn btn-sm dropdown-toggle d-flex align-items-center gap-2"
                                style="background:rgba(255,255,255,.12); color:#fff; border:1px solid rgba(255,255,255,.2); border-radius:8px;"
                                data-bs-toggle="dropdown">
                            <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold"
                                 style="width:28px;height:28px;background:var(--sf-green);font-size:.8rem;">
                                {{ app.user.pseudo|first|upper }}
                            </div>
                            {{ app.user.pseudo }}
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0" style="border-radius:10px;">
                            <li>
                                <a class="dropdown-item py-2" href="{{ path('app_profil') }}">
                                    <i class="bi bi-person me-2 text-muted"></i>Mon profil
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item py-2" href="{{ path('app_recommandation_generate') }}">
                                    <i class="bi bi-arrow-clockwise me-2 text-muted"></i>Actualiser mes recos
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item py-2 text-danger" href="{{ path('app_logout') }}">
                                    <i class="bi bi-box-arrow-right me-2"></i>Déconnexion
                                </a>
                            </li>
                        </ul>
                    </div>
                {% else %}
                    <a href="{{ path('app_login') }}"
                       class="btn btn-sm"
                       style="color:#fff; border:1px solid rgba(255,255,255,.35); border-radius:8px; padding:6px 16px;">
                        Connexion
                    </a>
                    <a href="{{ path('app_register') }}" class="btn btn-sm btn-sf" style="padding:6px 16px;">
                        S'inscrire
                    </a>
                {% endif %}
            </div>
        </div>
    </div>
</nav>

<!-- ══ FLASH MESSAGES ══ -->
{% set flashes = app.flashes %}
{% if flashes|length > 0 %}
<div class="container mt-3">
    {% for type, messages in flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}
</div>
{% endif %}

<!-- ══ CONTENU ══ -->
{% block body %}{% endblock %}

<!-- ══ FOOTER ══ -->
<footer class="footer-sf">
    <div class="container">
        <div class="row g-4 mb-4">
            <div class="col-lg-4">
                <h5 class="mb-3">🏸 SmashFit</h5>
                <p style="font-size:.9rem; line-height:1.7;">
                    Trouvez l'équipement de badminton parfaitement adapté à votre niveau
                    et votre style de jeu grâce à nos recommandations personnalisées.
                </p>
            </div>
            <div class="col-lg-2 col-6">
                <h6 class="mb-3">Navigation</h6>
                <ul class="list-unstyled" style="font-size:.9rem;">
                    <li class="mb-2"><a href="{{ path('app_home') }}">Accueil</a></li>
                    <li class="mb-2"><a href="{{ path('app_materiel_index') }}">Catalogue</a></li>
                    <li class="mb-2"><a href="{{ path('app_informations') }}">Informations</a></li>
                </ul>
            </div>
            <div class="col-lg-2 col-6">
                <h6 class="mb-3">Compte</h6>
                <ul class="list-unstyled" style="font-size:.9rem;">
                    {% if app.user %}
                    <li class="mb-2"><a href="{{ path('app_profil') }}">Mon profil</a></li>
                    <li class="mb-2"><a href="{{ path('app_recommandation_index') }}">Mes recos</a></li>
                    <li class="mb-2"><a href="{{ path('app_logout') }}">Déconnexion</a></li>
                    {% else %}
                    <li class="mb-2"><a href="{{ path('app_login') }}">Connexion</a></li>
                    <li class="mb-2"><a href="{{ path('app_register') }}">Inscription</a></li>
                    {% endif %}
                </ul>
            </div>
            <div class="col-lg-4">
                <h6 class="mb-3">Projet académique</h6>
                <p style="font-size:.85rem; line-height:1.6;">
                    Projet Fil Rouge CDA — IPSSI Lille<br>
                    Formation Concepteur Développeur d'Applications<br>
                    <span style="color:var(--sf-green);">Killian OCTAU — BD3 26.1</span>
                </p>
            </div>
        </div>
        <hr class="footer-divider">
        <p class="footer-bottom text-center mb-0">
            © {{ 'now'|date('Y') }} SmashFit — Tous droits réservés
        </p>
    </div>
</footer>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}{% endblock %}
{% block extra_js %}{% endblock %}
</body>
</html>